{
	"name": "webext-options-sync-per-domain",
	"version": "4.3.2",
	"description": "Helps you manage and autosave your extension's options, separately for each additional permission.",
	"license": "MIT",
	"repository": "fregante/webext-options-sync-per-domain",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"prepare": "tsc --sourceMap false",
		"test": "tsc --noEmit && xo",
		"watch": "tsc --watch"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"browser",
		"chrome",
		"extension",
		"firefox",
		"options",
		"sync",
		"domain",
		"origins",
		"request",
		"host",
		"webext"
	],
	"dependencies": {
		"memoize": "^11.0.0",
		"webext-detect": "^6.0.0",
		"webext-options-sync": "^4.3.0",
		"webext-patterns": "^3.0.0",
		"webext-permissions": "^6.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.6",
		"globals": "^17.13.0",
		"type-fest": "^5.10.0",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	}
}
